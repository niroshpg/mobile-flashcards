{
  "expo": {
    "name": "Mobile Flashcards",
    "slug": "mobile-flashcards",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "mobileflashcards",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.niroshpg.mobileflashcards"
    },
    "android": {
      "package": "com.niroshpg.mobileflashcards",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-notifications",
      "expo-font"
    ]
  }
}
